{
  "1": {
    "title": "負けず嫌い",
    "lines": [
      {
        "s": "中村",
        "j": "中尾の弟って、確か十歳だっけ。",
        "start": 4.06,
        "end": 7.75,
        "z": "中尾，你弟弟是不是十岁来着？"
      },
      {
        "s": "中尾",
        "j": "ううん。まだ五歳よ。",
        "start": 7.83,
        "end": 9.83,
        "z": "不是，他才五岁。"
      },
      {
        "s": "中村",
        "j": "まだ五歳かー。結構あいてるよな。",
        "start": 9.91,
        "end": 13.16,
        "z": "才五岁啊。你们年龄差得挺多的。"
      },
      {
        "s": "中尾",
        "j": "ええ。性格も全然違うわ。",
        "start": 13.24,
        "end": 15.71,
        "z": "是啊，性格也完全不一样。"
      },
      {
        "s": "中村",
        "j": "へエ？ アッ、わかった。弟は中尾と反対で、腕白なんだろ？",
        "start": 15.79,
        "end": 21.11,
        "z": "咦？啊，我知道了。你弟弟跟你相反，是个淘气鬼吧？"
      },
      {
        "s": "中尾",
        "j": "ん？ っていうか、どっちかというと、負けず嫌いかな。",
        "start": 21.19,
        "end": 24.24,
        "z": "嗯？怎么说呢，要说起来，他更像是不服输吧。"
      },
      {
        "s": "中村",
        "j": "ふうん。",
        "start": 24.32,
        "end": 25.8,
        "z": "哦。"
      },
      {
        "s": "中尾",
        "j": "たとえばね、この間、弟がデパートで迷子になったのよ。",
        "start": 25.88,
        "end": 29.9,
        "z": "比如说，前些天我弟弟在百货商店走丢了。"
      },
      {
        "s": "中尾",
        "j": "お母さんが必死で探していたら、館内放送が入って、「こうじ（幸司）君のお母さんが迷子になっています。",
        "start": 29.98,
        "end": 36.46,
        "z": "妈妈正拼命找他时，商场里广播说：“幸司小朋友的妈妈走失了。"
      },
      {
        "s": "中尾",
        "j": "こうじ君が待っておられますので、一階インフォメーションセンターまでお越しください」って流したんだって。",
        "start": 36.54,
        "end": 42.36,
        "z": "幸司小朋友正在等您，请到一楼服务台来。”广播居然这么说。"
      },
      {
        "s": "中尾",
        "j": "お母さん、あわてて、飛んでいって、お店の人に平謝りだったんだよね。 もう、一事が万事、そんな感じ。",
        "start": 42.44,
        "end": 48.52,
        "z": "妈妈慌忙跑过去，一个劲儿地向店员道歉。总之，从这件事就能看出他平时也是那个样子。"
      },
      {
        "s": "中村",
        "j": "あははは……！ でも、それって負けず嫌いかぁ？",
        "start": 48.6,
        "end": 53.27,
        "z": "哈哈哈！不过，这算是不服输吗？"
      },
      {
        "s": "中尾",
        "j": "だって、あの子ったら、お店の人にずうっと絶対自分は迷子じゃないんだって。 お母さんが迷子になったんだって言い張ってたんだって。",
        "start": 53.35,
        "end": 60.96,
        "z": "因为那孩子一直坚持跟店员说，迷路的绝对不是自己，而是妈妈走丢了。"
      },
      {
        "s": "中尾",
        "j": "だから、お店の人も泣かれたら困るから、館内放送がそんなのになっちゃったんだって。",
        "start": 61.04,
        "end": 65.64,
        "z": "店员怕把他惹哭了不好办，所以广播才变成那样。"
      },
      {
        "s": "中村",
        "j": "そうなんだ。ハハハ。すごい頑固だね、五歳にしては。 それじゃ、先が思いやられるな。",
        "start": 65.72,
        "end": 74.25,
        "z": "原来如此。哈哈哈。对一个五岁的孩子来说，他可真固执。这样下去，真让人担心他的将来。"
      },
      {
        "s": "中村",
        "j": "でも、そういうところ、うちのおじいちゃんと一緒だな。",
        "start": 74.33,
        "end": 79.04,
        "z": "不过，这点倒是跟我爷爷一样。"
      },
      {
        "s": "中尾",
        "j": "中村君のおじいさんも負けず嫌いなの？",
        "start": 79.12,
        "end": 81.54,
        "z": "中村，你爷爷也不服输吗？"
      },
      {
        "s": "中村",
        "j": "そう。もうそのもの、ずばり。",
        "start": 81.62,
        "end": 84.75,
        "z": "是啊，简直就是那样。"
      },
      {
        "s": "中村",
        "j": "おじいちゃん、今七十八歳なんだけどさ、ついこないだまで大工をしてたんだ。 で、「いまどきの若いもんは～」とか言っちゃってさ。",
        "start": 84.83,
        "end": 93.15,
        "z": "我爷爷现在七十八岁，可直到前不久还在做木工。而且还老说“现在的年轻人啊……”之类的话。"
      },
      {
        "s": "中村",
        "j": "おじいちゃんたら、七十になっても、自分で足場に上がってたんだよね。 だけどさ、やっぱり、年じゃない？",
        "start": 93.23,
        "end": 100.65,
        "z": "爷爷都七十岁了，还自己爬上脚手架。可毕竟上了年纪，对吧？"
      },
      {
        "s": "中村",
        "j": "で、案の定、足場から落っこちちゃってね、足の骨を二箇所も折る大怪我だったんだよ。 もう大騒ぎになってさぁ。",
        "start": 100.73,
        "end": 108.85,
        "z": "果不其然，他从脚手架上摔下来，两处腿骨都骨折了，伤得很重。这下可闹大了。"
      },
      {
        "s": "中村",
        "j": "おばあちゃんとか、お母さんとかが必死でとめたんだ。「もう年なんだから高いところに上る仕事はやめて」ってさ。",
        "start": 108.93,
        "end": 115.87,
        "z": "奶奶和妈妈都拼命劝他：“你年纪大了，别再做爬高的活儿了。”"
      },
      {
        "s": "中村",
        "j": "だけど、うちのおじいちゃんったら、「落ちたんじゃない、自分で飛び降りたんだ！」って言い張ってたんだよね。",
        "start": 115.95,
        "end": 124.34,
        "z": "可我爷爷偏说：“我不是摔下来的，是自己跳下来的！”"
      },
      {
        "s": "中尾",
        "j": "ふふふふ、それってすごいイジッパリだよね。",
        "start": 124.42,
        "end": 127.65,
        "z": "呵呵呵，他可真倔啊。"
      },
      {
        "s": "中尾",
        "j": "頑固さにかけては、うちの弟とどっこいどっこいだね。 いい勝負ね。なんだか他人ごととは思えない。",
        "start": 127.73,
        "end": 134.46,
        "z": "论固执，他和我弟弟不相上下。真是势均力敌。总觉得这事跟我家也脱不了关系。"
      }
    ],
